# ============================================================
# JobPilot AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ---- Groq AI ------------------------------------------------
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- PostgreSQL ---------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/jobpilot

# ---- Authentication -----------------------------------------
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ---- Adzuna Job API (Optional) ------------------------------
# Free tier: 250 req/month. Register at: https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ---- Job Freshness Policy -----------------------------------
JOB_FRESHNESS_REUSE_HOURS=6
JOB_FRESHNESS_REFRESH_HOURS=24